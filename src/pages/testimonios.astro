
---
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import Tabs from '../components/Tabs.astro';

const testimonialTabs = [
  { id: 'asesorias', label: 'Asesorías Académicas', active: true },
  { id: 'proyectos', label: 'Proyectos Especiales' }
];

const academicTestimonials = [
  {
    name: "María Fernanda Gómez",
    role: "Estudiante de Ingeniería Civil - Universidad Minuto de Dios",
    content: "Gracias a las asesorías de Andrea en cálculo diferencial, logré pasar la materia con una excelente calificación. Su metodología es muy clara y personalizada.",
    rating: 5,
    subject: "Cálculo Diferencial"
  },
  {
    name: "Carlos Andrés Rivera",
    role: "Estudiante de Bachillerato - Colegio San Bartolomé",
    content: "Las clases de física con el equipo de AVL me ayudaron a entender conceptos que creía imposibles. Ahora la física es una de mis materias favoritas.",
    rating: 5,
    subject: "Física Mecánica"
  },
  {
    name: "Ana Lucía Martínez",
    role: "Estudiante de Licenciatura en Lenguas - UFPS",
    content: "Valentina me ayudó enormemente con mi tesis de grado. Su experiencia en redacción académica fue fundamental para mi éxito.",
    rating: 5,
    subject: "Redacción Académica"
  },
  {
    name: "Diego Alejandro Torres",
    role: "Estudiante de Ingeniería de Sistemas - UNIPAMPLONA",
    content: "Los algoritmos y estructuras de datos eran mi pesadilla hasta que conocí a Luis Miguel. Ahora programa con confianza y claridad.",
    rating: 5,
    subject: "Programación"
  },
  {
    name: "Sofía Valentina Ruiz",
    role: "Estudiante de Química - Universidad Nacional",
    content: "La química orgánica se volvió comprensible gracias a las explicaciones detalladas y los ejercicios prácticos que me proporcionaron.",
    rating: 5,
    subject: "Química Orgánica"
  },
  {
    name: "Juan Pablo Herrera",
    role: "Estudiante de Bachillerato - Colegio Calasanz",
    content: "Mi preparación para el ICFES fue excelente. Subí 40 puntos gracias a las estrategias y simulacros que me dieron.",
    rating: 5,
    subject: "Preparación ICFES"
  }
];

const projectTestimonials = [
  {
    name: "InnovaTech Solutions",
    role: "Startup de Tecnología",
    content: "AVL Asesorías nos ayudó a validar técnicamente nuestra propuesta para la convocatoria de Innpulsa. Su apoyo fue clave para obtener la financiación.",
    rating: 5,
    subject: "Validación Técnica"
  },
  {
    name: "Corporación Educativa del Norte",
    role: "Institución Educativa",
    content: "Los talleres de metodología de estudio que dictaron para nuestros estudiantes mejoraron significativamente el rendimiento académico.",
    rating: 5,
    subject: "Talleres Grupales"
  },
  {
    name: "EcoVerde Cúcuta",
    role: "Empresa de Sostenibilidad",
    content: "Necesitábamos capacitar a nuestro equipo en análisis de datos ambientales. El programa que desarrollaron fue exactamente lo que buscábamos.",
    rating: 5,
    subject: "Capacitación Empresarial"
  },
  {
    name: "Laura Melissa Contreras",
    role: "Emprendedora - Proyecto FoodTech",
    content: "Me ayudaron a desarrollar la parte técnica de mi plan de negocio para la industria alimentaria. Ahora tengo una startup exitosa.",
    rating: 5,
    subject: "Plan de Negocio"
  }
];

function generateStars(rating: number) {
  return Array.from({ length: 5 }, (_, i) => i < rating);
}
---

<Layout 
  title="Testimonios - AVL Asesorías" 
  description="Lee los testimonios de estudiantes y empresas que han confiado en AVL Asesorías para mejorar su rendimiento académico y profesional."
>
  <!-- Hero Section -->
  <Banner
    title="Lo que Dicen Nuestros Estudiantes"
    subtitle="💬 Testimonios Reales"
    description="Descubre cómo hemos ayudado a cientos de estudiantes y empresas a alcanzar sus objetivos académicos y profesionales."
    variant="default"
  />

  <!-- Testimonials Section -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-gradient mb-4">
          Historias de Éxito
        </h2>
        <p class="text-xl text-neutral-700 max-w-3xl mx-auto">
          Cada testimonio representa una historia de superación académica y 
          profesional que nos motiva a seguir brindando la mejor asesoría.
        </p>
      </div>

      <Tabs tabs={testimonialTabs} variant="underline">
        <!-- Asesorías Académicas Tab -->
        <div class="tab-panel" data-tab-content="asesorias">
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {academicTestimonials.map((testimonial, index) => (
              <div class="card p-6 hover-lift space-y-4">
                <!-- Rating -->
                <div class="flex space-x-1">
                  {generateStars(testimonial.rating).map((filled, i) => (
                    <svg class={`w-5 h-5 ${filled ? 'text-yellow-400' : 'text-neutral-300'}`} fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  ))}
                </div>

                <!-- Content -->
                <blockquote class="text-neutral-700 italic leading-relaxed">
                  "{testimonial.content}"
                </blockquote>

                <!-- Subject Tag -->
                <div class="inline-block">
                  <span class="bg-primary-100 text-primary-800 px-3 py-1 rounded-full text-xs font-medium">
                    {testimonial.subject}
                  </span>
                </div>

                <!-- Author -->
                <div class="border-t pt-4 space-y-1">
                  <h4 class="font-semibold text-neutral-800">{testimonial.name}</h4>
                  <p class="text-sm text-neutral-700">{testimonial.role}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Proyectos Especiales Tab -->
        <div class="tab-panel hidden" data-tab-content="proyectos">
          <div class="grid md:grid-cols-2 gap-8">
            {projectTestimonials.map((testimonial, index) => (
              <div class="card p-8 hover-lift space-y-6">
                <!-- Rating -->
                <div class="flex space-x-1">
                  {generateStars(testimonial.rating).map((filled, i) => (
                    <svg class={`w-6 h-6 ${filled ? 'text-yellow-400' : 'text-neutral-300'}`} fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  ))}
                </div>

                <!-- Content -->
                <blockquote class="text-lg text-neutral-700 italic leading-relaxed">
                  "{testimonial.content}"
                </blockquote>

                <!-- Subject Tag -->
                <div class="inline-block">
                  <span class="bg-accent-500/10 text-accent-500 px-4 py-2 rounded-full text-sm font-medium">
                    {testimonial.subject}
                  </span>
                </div>

                <!-- Author -->
                <div class="border-t pt-6 space-y-2">
                  <h4 class="text-xl font-semibold text-neutral-800">{testimonial.name}</h4>
                  <p class="text-neutral-700">{testimonial.role}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </Tabs>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="section-padding bg-gradient-to-br from-primary-600 to-accent-500 text-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold mb-4">
          Números que Respaldan Nuestra Calidad
        </h2>
        <p class="text-xl opacity-90 max-w-2xl mx-auto">
          Resultados medibles que demuestran el impacto positivo de nuestras asesorías.
        </p>
      </div>

      <div class="grid md:grid-cols-4 gap-6">
        <div class="text-center space-y-3">
          <div class="text-4xl lg:text-5xl font-bold">98%</div>
          <div class="text-lg opacity-90">Satisfacción</div>
          <div class="text-sm opacity-75">De estudiantes satisfechos con nuestro servicio</div>
        </div>

        <div class="text-center space-y-3">
          <div class="text-4xl lg:text-5xl font-bold">500+</div>
          <div class="text-lg opacity-90">Estudiantes</div>
          <div class="text-sm opacity-75">Han mejorado sus calificaciones con nosotros</div>
        </div>

        <div class="text-center space-y-3">
          <div class="text-4xl lg:text-5xl font-bold">85%</div>
          <div class="text-lg opacity-90">Mejora Promedio</div>
          <div class="text-sm opacity-75">En las calificaciones de nuestros estudiantes</div>
        </div>

        <div class="text-center space-y-3">
          <div class="text-4xl lg:text-5xl font-bold">24/7</div>
          <div class="text-lg opacity-90">Soporte</div>
          <div class="text-sm opacity-75">Atención y comunicación disponible siempre</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Video Testimonials Section -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-neutral-800 mb-4">
          Testimonios en Video
        </h2>
        <p class="text-xl text-neutral-700 max-w-2xl mx-auto">
          Escucha directamente de nuestros estudiantes sobre su experiencia con AVL Asesorías.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Video Placeholder 1 -->
        <div class="card overflow-hidden hover-lift">
          <div class="aspect-video bg-gradient-to-br from-primary-500 to-accent-500 flex items-center justify-center relative">
            <div class="text-center text-white">
              <svg class="w-16 h-16 mx-auto mb-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
              <p class="font-medium">Andrea Vargas</p>
              <p class="text-sm opacity-90">Cálculo Diferencial</p>
            </div>
            <div class="absolute inset-0 bg-black/20 opacity-0 hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <button class="bg-white text-primary-600 rounded-full p-4 hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </button>
            </div>
          </div>
          <div class="p-4">
            <h3 class="font-semibold text-neutral-800 mb-2">María Fernanda</h3>
            <p class="text-sm text-neutral-700">
              "Gracias a AVL Asesorías pude superar el cálculo diferencial..."
            </p>
          </div>
        </div>

        <!-- Video Placeholder 2 -->
        <div class="card overflow-hidden hover-lift">
          <div class="aspect-video bg-gradient-to-br from-blue-500 to-primary-600 flex items-center justify-center relative">
            <div class="text-center text-white">
              <svg class="w-16 h-16 mx-auto mb-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
              <p class="font-medium">Luis Miguel Torres</p>
              <p class="text-sm opacity-90">Programación</p>
            </div>
            <div class="absolute inset-0 bg-black/20 opacity-0 hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <button class="bg-white text-blue-600 rounded-full p-4 hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </button>
            </div>
          </div>
          <div class="p-4">
            <h3 class="font-semibold text-neutral-800 mb-2">Diego Torres</h3>
            <p class="text-sm text-neutral-700">
              "Los algoritmos ya no son un misterio para mí..."
            </p>
          </div>
        </div>

        <!-- Video Placeholder 3 -->
        <div class="card overflow-hidden hover-lift">
          <div class="aspect-video bg-gradient-to-br from-green-500 to-primary-600 flex items-center justify-center relative">
            <div class="text-center text-white">
              <svg class="w-16 h-16 mx-auto mb-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
              <p class="font-medium">Valentina Ruiz</p>
              <p class="text-sm opacity-90">Redacción</p>
            </div>
            <div class="absolute inset-0 bg-black/20 opacity-0 hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <button class="bg-white text-green-600 rounded-full p-4 hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </button>
            </div>
          </div>
          <div class="p-4">
            <h3 class="font-semibold text-neutral-800 mb-2">Ana Lucía</h3>
            <p class="text-sm text-neutral-700">
              "Mi tesis fue un éxito gracias a su apoyo..."
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding bg-gradient-to-br from-primary-50 to-neutral-50">
    <div class="container-custom text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-neutral-800 mb-6">
        ¿Quieres Ser Nuestro Próximo Caso de Éxito?
      </h2>

      <p class="text-xl text-neutral-700 mb-8 max-w-2xl mx-auto">
        Únete a los cientos de estudiantes que ya han transformado 
        su rendimiento académico con nuestras asesorías especializadas.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="https://wa.me/573001234567" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-primary text-lg px-8 py-4"
        >
          Comenzar Ahora
        </a>

        <a 
          href="/servicios" 
          class="btn btn-outline text-lg px-8 py-4"
        >
          Ver Servicios
        </a>
      </div>
    </div>
  </section>
</Layout>

