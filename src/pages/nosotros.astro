
---
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import TeamList from '../components/TeamList.astro';

const teamMembers = [
  {
    name: "Andrea Vargas",
    role: "Ingeniera Civil - Especialista en Matemáticas",
    bio: "Graduada con honores, especializada en cálculo diferencial e integral, álgebra lineal y física aplicada.",
    social: {
      email: "info@avlasesorias.com",
      linkedin: "https://linkedin.com/in/andrea-vargas"
    }
  },
  {
    name: "Luis Miguel Torres",
    role: "Ingeniero de Sistemas - Especialista en Programación",
    bio: "Experto en programación, algoritmos, estructuras de datos y matemáticas discretas.",
    social: {
      email: "info@avlasesorias.com",
      linkedin: "https://linkedin.com/in/luis-torres"
    }
  },
  {
    name: "Valentina Ruiz",
    role: "Licenciada en Humanidades - Especialista en Redacción",
    bio: "Especialista en redacción académica, comprensión lectora, filosofía y ciencias sociales.",
    social: {
      email: "valentina@avlasesorias.com",
      linkedin: "https://linkedin.com/in/valentina-ruiz"
    }
  }
];

const socialContributions = [
  {
    title: "Programa de Becas",
    description: "Ofrecemos 10 becas mensuales para estudiantes de bajos recursos económicos.",
    year: "2023 - Presente"
  },
  {
    title: "Talleres Gratuitos",
    description: "Dictamos talleres de metodología de estudio en colegios públicos de Cúcuta.",
    year: "2023"
  },
  {
    title: "Material Educativo",
    description: "Creamos y distribuimos gratuitamente guías de estudio digitales.",
    year: "2023 - Presente"
  },
  {
    title: "Apoyo a Universitarios",
    description: "Mentorías gratuitas para estudiantes de primer semestre universitario.",
    year: "2023"
  }
];
---

<Layout 
  title="Nosotros - AVL Asesorías" 
  description="Conoce al equipo de profesionales de AVL Asesorías. Ingenieros y especialistas comprometidos con la excelencia académica en Cúcuta."
>
  <!-- Hero Section -->
  <Banner
    title="Conoce Nuestro Equipo"
    subtitle="👥 Profesionales Comprometidos"
    description="Un equipo de profesionales recién egresados con pasión por la enseñanza y el compromiso de transformar el futuro académico de nuestros estudiantes."
    variant="default"
  />

  <!-- Team Section -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-gradient mb-4">
          Nuestro Equipo de Especialistas
        </h2>
        <p class="text-xl text-neutral-700 max-w-3xl mx-auto">
          Profesionales recién egresados con formación de excelencia y experiencia práctica 
          en sus áreas de especialización, comprometidos con tu éxito académico.
        </p>
      </div>

      <TeamList members={teamMembers} columns={3} />
    </div>
  </section>

  <!-- Contact Form Section -->
  <section id="contacto" class="section-padding bg-gradient-to-br from-primary-50 to-neutral-50">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl lg:text-4xl font-bold text-neutral-800 mb-4">
            Contáctanos
          </h2>
          <p class="text-xl text-neutral-700">
            ¿Listo para comenzar? Escríbenos y te contactaremos para coordinar tu primera sesión.
          </p>
        </div>

        <div class="card p-8 lg:p-12 text-center">
          <div class="mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-primary-50 text-primary-600 rounded-full mb-4">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-neutral-800 mb-2">Formulario Temporalmente Inactivo</h3>
            <p class="text-neutral-700 max-w-md mx-auto">
              Nuestro sistema de mensajería está en mantenimiento. Por favor, contáctanos directamente a través de nuestros canales oficiales:
            </p>
          </div>

          <div class="grid sm:grid-cols-2 gap-4 max-w-lg mx-auto">
            <a
              href="https://wa.me/573001234567"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary flex items-center justify-center space-x-2"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
              </svg>
              <span>WhatsApp</span>
            </a>
            <a
              href="mailto:contacto@avlasesorias.com"
              class="btn btn-outline flex items-center justify-center space-x-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span>Email</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Join Team CTA -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl lg:text-4xl font-bold text-neutral-800 mb-6">
          ¿Quieres Ser Parte del Equipo?
        </h2>

        <p class="text-xl text-neutral-700 mb-8">
          Si eres un profesional recién egresado con pasión por la enseñanza, 
          nos encantaría conocerte y explorar oportunidades de colaboración.
        </p>

        <div class="bg-gradient-to-r from-primary-50 to-accent-500/10 rounded-2xl p-8 lg:p-12">
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div class="space-y-4 text-left">
              <h3 class="text-2xl font-semibold text-neutral-800">
                Buscamos profesionales que:
              </h3>
              <ul class="space-y-3 text-neutral-700">
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-primary-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span>Sean recién egresados (máximo 2 años)</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-primary-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span>Tengan excelencia académica</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-primary-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span>Disfruten enseñar y compartir conocimiento</span>
                </li>
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-primary-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span>Se comprometan con la calidad educativa</span>
                </li>
              </ul>
            </div>

            <div class="text-center">
              <a 
                href="mailto:empleo@avlasesorias.com" 
                class="btn btn-primary text-lg px-8 py-4"
              >
                Enviar CV
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Contributions -->
  <section class="section-padding bg-gradient-to-br from-neutral-900 to-neutral-800 text-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">
          Nuestros Aportes Sociales
        </h2>
        <p class="text-xl text-neutral-300 max-w-3xl mx-auto">
          Creemos en la educación como motor de transformación social. 
          Estos son algunos de nuestros programas de impacto comunitario.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {socialContributions.map((contribution, index) => (
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 lg:p-8 hover-lift">
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 bg-gradient-to-r from-primary-500 to-accent-500 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              </div>

              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="text-xl font-semibold text-white">
                    {contribution.title}
                  </h3>
                  <span class="text-sm text-primary-300 font-medium">
                    {contribution.year}
                  </span>
                </div>
                <p class="text-neutral-300 leading-relaxed">
                  {contribution.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
