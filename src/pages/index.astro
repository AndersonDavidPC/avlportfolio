
---
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import Cards from '../components/Cards.astro';

const services = [
  {
    title: "Asesorías Académicas",
    description: "Apoyo personalizado en materias de ingeniería, ciencias básicas y humanidades. Metodología adaptada a cada estudiante.",
    icon: "M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z",
    href: "/servicios"
  },
  {
    title: "Modalidad Presencial",
    description: "Clases presenciales en Cúcuta y área metropolitana. Atención directa y personalizada en tu ubicación preferida.",
    icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
    href: "/nosotros"
  },
  {
    title: "Modalidad Remota",
    description: "Asesorías virtuales para estudiantes en todo Colombia. Tecnología de punta para una experiencia de aprendizaje óptima.",
    icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
    href: "/servicios"
  }
];

const stats = [
  {
    title: "500+",
    description: "Estudiantes han mejorado sus calificaciones con nuestro apoyo académico personalizado.",
    badge: "Estudiantes Exitosos"
  },
  {
    title: "98%",
    description: "De satisfacción en nuestros servicios de asesoría académica y acompañamiento estudiantil.",
    badge: "Satisfacción"
  },
  {
    title: "24/7",
    description: "Soporte y comunicación disponible para resolver dudas y coordinar sesiones de estudio.",
    badge: "Disponibilidad"
  }
];
---

<Layout
  title="AVL Asesorías - Excelencia Académica en Cúcuta y Colombia"
  description="Especialistas en asesorías académicas presenciales en Cúcuta y remotas en todo Colombia. Profesionales en ingeniería, ciencias básicas y humanidades."
>
  <!-- Hero Section -->
  <Banner
    title="Transforma tu Futuro Académico"
    subtitle="🎓 Excelencia Educativa"
    description="Asesorías académicas especializadas impartidas por profesionales recién egresados. Modalidad presencial en Cúcuta y área metropolitana, y remota en todo Colombia."
    ctaText="Comienza Ahora"
    ctaUrl="#contacto"
    variant="gradient"
  />

  <!-- Services Section -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-gradient mb-4">
          Nuestros Servicios Especializados
        </h2>
        <p class="text-xl text-neutral-700 max-w-3xl mx-auto">
          Ofrecemos asesorías académicas personalizadas con metodologías innovadoras
          y profesionales altamente capacitados en cada área de conocimiento.
        </p>
      </div>

      <Cards cards={services} columns={3} />
    </div>
  </section>

  <!-- Stats Section -->
  <section class="section-padding bg-gradient-to-br from-primary-50 to-neutral-50">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-neutral-800 mb-4">
          Resultados que Hablan por Sí Solos
        </h2>
        <p class="text-xl text-neutral-700 max-w-2xl mx-auto">
          Nuestros números reflejan el compromiso y la calidad de nuestros servicios educativos.
        </p>
      </div>

      <Cards cards={stats} columns={3} variant="services" />
    </div>
  </section>

  <!-- About Preview -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <h2 class="text-3xl lg:text-4xl font-bold text-neutral-800">
            ¿Por qué elegir <span class="text-gradient">AVL Asesorías</span>?
          </h2>

          <p class="text-lg text-neutral-700 leading-relaxed">
            Somos un equipo de profesionales recién egresados con experiencia práctica
            y metodologías actualizadas. Entendemos los desafíos académicos actuales
            y ofrecemos soluciones efectivas y personalizadas.
          </p>

          <div class="space-y-4">
            <div class="flex items-start space-x-4">
              <div class="w-6 h-6 bg-gradient-to-r from-primary-500 to-accent rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-neutral-800">Profesionales Especializados</h3>
                <p class="text-neutral-700">Ingenieros, científicos y humanistas con formación actualizada.</p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="w-6 h-6 bg-gradient-to-r from-primary-500 to-accent rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-neutral-800">Metodología Personalizada</h3>
                <p class="text-neutral-700">Adaptamos cada sesión al ritmo y estilo de aprendizaje del estudiante.</p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="w-6 h-6 bg-gradient-to-r from-primary-500 to-accent rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-neutral-800">Flexibilidad Total</h3>
                <p class="text-neutral-700">Clases presenciales en Cúcuta y virtuales en todo Colombia.</p>
              </div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/nosotros" class="btn btn-primary">
              Conoce Nuestro Equipo
            </a>
            <a href="/testimonios" class="btn btn-outline">
              Ver Testimonios
            </a>
          </div>
        </div>

        <div class="relative">
          <div class="relative z-10">
            <svg class="w-full h-auto max-w-lg mx-auto" viewBox="0 0 500 400" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Background -->
              <circle cx="250" cy="200" r="180" fill="url(#teamGrad)" opacity="0.05"/>
              
              <!-- Growth Path -->
              <path d="M100 300 Q250 300 400 100" stroke="url(#teamGrad)" stroke-width="4" stroke-dasharray="8 8" opacity="0.3"/>
              
              <!-- Character/Student Icon -->
              <g transform="translate(210, 150)">
                <circle cx="40" cy="30" r="25" fill="url(#teamGrad)"/>
                <path d="M0 100 C0 70 80 70 80 100" fill="url(#teamGrad)" opacity="0.6"/>
                <!-- Success indicator -->
                <circle cx="70" cy="10" r="12" fill="#10b981"/>
                <path d="M65 10 L68 13 L75 7" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </g>

              <!-- Books/Knowledge Stack -->
              <g transform="translate(100, 250)">
                <rect x="0" y="20" width="80" height="15" rx="2" fill="#cbd5e1"/>
                <rect x="5" y="5" width="70" height="15" rx="2" fill="#94a3b8"/>
                <rect x="10" y="-10" width="60" height="15" rx="2" fill="url(#teamGrad)"/>
              </g>

              <!-- Floating Success Elements -->
              <g class="animate-bounce-gentle">
                <rect x="380" y="80" width="40" height="50" rx="4" fill="white" shadow="lg"/>
                <path d="M390 100 H410 M390 110 H405 M390 120 H410" stroke="url(#teamGrad)" stroke-width="2" opacity="0.5"/>
                <text x="390" y="95" fill="url(#teamGrad)" font-size="10" font-weight="bold">A+</text>
              </g>

              <!-- Connecting Dots -->
              <circle cx="150" cy="150" r="4" fill="url(#teamGrad)" opacity="0.4"/>
              <circle cx="350" cy="250" r="6" fill="#ffd700" opacity="0.6"/>
              <circle cx="400" cy="180" r="5" fill="#ff006e" opacity="0.4"/>

              <defs>
                <linearGradient id="teamGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:#dc4dff;stop-opacity:1" />
                  <stop offset="100%" style="stop-color:#ff006e;stop-opacity:1" />
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section id="contacto" class="section-padding bg-gradient-to-br from-primary-600 to-accent text-white">
    <div class="container-custom text-center">
      <h2 class="text-3xl lg:text-4xl font-bold mb-6">
        ¿Listo para Mejorar tus Calificaciones?
      </h2>

      <p class="text-xl mb-8 max-w-2xl mx-auto opacity-90">
        Contáctanos hoy mismo y descubre cómo podemos ayudarte a alcanzar
        tus objetivos académicos con nuestras asesorías especializadas.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="https://wa.me/573001234567"
          target="_blank"
          rel="noopener noreferrer"
          class="btn bg-white text-primary-700 hover:bg-neutral-100 px-8 py-4 text-lg font-semibold flex items-center space-x-2"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
          </svg>
          <span>WhatsApp</span>
        </a>

        <a
          href="mailto:info@avlasesorias.com"
          class="btn btn-outline border-white text-white hover:bg-white hover:text-primary-700 px-8 py-4 text-lg font-semibold flex items-center space-x-2"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span>Email</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
