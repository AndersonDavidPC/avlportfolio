
---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Política de Privacidad - AVL Asesorías"
  description="Nuestra política de privacidad está en construcción."
>
  <section class="section-padding bg-gradient-to-br from-primary-50 to-neutral-50 min-h-[60vh] flex items-center">
    <div class="container-custom text-center">
      <div class="max-w-3xl mx-auto space-y-8">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-primary-100 text-primary-600 rounded-full mb-6">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m0 0v2m0-2h2m-2 0H10m11-3.5a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h1 class="text-4xl lg:text-5xl font-bold text-neutral-800">
          Política de <span class="text-gradient">Privacidad</span>
        </h1>
        <p class="text-xl text-neutral-600 leading-relaxed">
          Estamos actualizando nuestra política de privacidad para asegurarnos de proteger 
          tus datos de la mejor manera posible. Muy pronto estará disponible.
        </p>
        <div class="pt-8">
          <a href="/" class="btn btn-primary">
            Volver al Inicio
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
