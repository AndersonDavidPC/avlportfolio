const quickLinks = [
  { name: 'Inicio', href: '/' },
  { name: 'Nosotros', href: '/nosotros' },
  { name: 'Servicios', href: '/servicios' },
  { name: 'Testimonios', href: '/testimonios' },
  { name: 'Aliados', href: '/aliados' },
];

const services = [
  { name: 'Asesorías Colegio', href: '/servicios#colegio' },
  { name: 'Asesorías Universidad', href: '/servicios#universidad' },
  { name: 'Emprendedores', href: '/servicios#emprendedores' },
  { name: 'Empresas', href: '/servicios#empresas' },
];
---

<footer class="bg-gradient-to-br from-primary-950 to-primary-900 text-white">
  <!-- Main Footer Content -->
  <div class="container-custom section-padding">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

      <!-- Company Info -->
      <div class="space-y-6">
        <div class="flex items-center space-x-3">
          <img src="/favicon.svg" alt="Logo AVL Asesorías" class="w-10 h-10 object-contain" />
          <div>
            <h3 class="text-xl font-bold text-white">AVL Asesorías</h3>
            <p class="text-sm text-primary-200">Excelencia Académica</p>
          </div>
        </div>

        <p class="text-white/90 leading-relaxed">
          Especialistas en asesorías académicas presenciales en Cúcuta y área metropolitana, 
          y remotas en todo Colombia. Profesionales recién egresados en ingeniería, ciencias básicas y humanidades.
        </p>

        <!-- Social Links -->
        <div class="flex space-x-4">
          {socialLinks.map((social) => (
            <a 
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-primary-800 hover:bg-accent-500 p-3 rounded-lg transition-colors duration-300 hover-lift"
              aria-label={`Síguenos en ${social.name}`}
            >
              <svg class="w-5 h-5 text-white" viewBox={social.viewBox || "0 0 24 24"} fill="currentColor">
                <path d={social.icon}/>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-6">
        <h4 class="text-lg font-semibold text-white">Enlaces Rápidos</h4>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a 
                href={link.href}
                class="text-primary-100 hover:text-accent-700 transition-colors duration-300 hover:translate-x-1 transform inline-block"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div class="space-y-6">
        <h4 class="text-lg font-semibold text-white">Nuestros Servicios</h4>
        <ul class="space-y-3">
          {services.map((service) => (
            <li>
              <a 
                href={service.href}
                class="text-primary-100 hover:text-accent-700 transition-colors duration-300 hover:translate-x-1 transform inline-block"
              >
                {service.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="space-y-6">
        <h4 class="text-lg font-semibold text-white">Contacto</h4>

        <div class="space-y-4">
          <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-accent-700 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <div>
              <p class="text-white">Cúcuta, Norte de Santander</p>
              <p class="text-sm text-primary-200">Colombia</p>
            </div>
          </div>

          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5 text-accent-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href="tel:+573223695520" class="text-white hover:text-accent-700 transition-colors">
              +57 322 369 5520
            </a>
          </div>

          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5 text-accent-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href="mailto:info@avlasesorias.com" class="text-white hover:text-accent-700 transition-colors">
              info@avlasesorias.com
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="border-t border-primary-800">
    <div class="container-custom py-6">
      <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
        <p class="text-primary-100 text-sm">
          © {new Date().getFullYear()} AVL Asesorías. Todos los derechos reservados.
        </p>

        <div class="flex space-x-6 text-sm">
          <a href="/privacidad" class="text-primary-100 hover:text-accent-700 transition-colors">
            Política de Privacidad
          </a>
          <a href="/terminos" class="text-primary-100 hover:text-accent-700 transition-colors">
            Términos de Uso
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
