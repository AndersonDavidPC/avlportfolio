---
export interface Props {
  name: string;
}

const { name } = Astro.props;
---

<section class="section-padding bg-gradient-to-br from-primary-50 to-neutral-50 min-h-[40vh] flex items-center">
  <div class="container-custom text-center">
    <div class="w-16 h-16 bg-gradient-to-r from-primary-500 to-primary-700 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
      </svg>
    </div>

    <h2 class="text-3xl lg:text-4xl font-bold text-neutral-800 mb-4">
      Portafolio en construcción
    </h2>

    <p class="text-xl text-neutral-700 max-w-2xl mx-auto mb-8">
      Estamos preparando el portafolio personal de {name}. Muy pronto encontrarás aquí su experiencia y trayectoria completa.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/nosotros" class="btn btn-outline">
        Volver al Equipo
      </a>
      <a href="/#contacto" class="btn btn-primary">
        Contáctanos
      </a>
    </div>
  </div>
</section>
