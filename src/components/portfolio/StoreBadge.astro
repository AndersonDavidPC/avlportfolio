---
export interface Props {
  store: 'appStore' | 'playStore';
  href: string;
  appName: string;
}

const { store, href, appName } = Astro.props;

const copy = {
  appStore: { line1: 'Descárgala en', line2: 'App Store', storeLabel: 'App Store' },
  playStore: { line1: 'Disponible en', line2: 'Google Play', storeLabel: 'Google Play' },
}[store];
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center gap-2 bg-neutral-900 hover:bg-neutral-800 text-white rounded-lg px-3 py-2 transition-colors duration-300 focus:outline-none focus:ring-4 focus:ring-primary-300"
  aria-label={`Descargar ${appName} en ${copy.storeLabel}`}
>
  {store === 'appStore' ? (
    <svg class="w-6 h-6 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.75 1.95-.1.06-2.24 1.31-2.21 3.84.03 3.03 2.65 4.04 2.68 4.05-.02.07-.42 1.44-1.4 2.82zM13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
    </svg>
  ) : (
    <svg class="w-6 h-6 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
      <path d="M3.61 1.81A1 1 0 003 2.75v18.5a1 1 0 00.61.94l10.89-10.19L3.61 1.81zM16.08 10.5l2.9-2.72 3.37 1.95c.9.52.9 1.82 0 2.34l-3.37 1.95-2.9-2.72v-.8zM14.67 11.9l-11 10.3 9.72-5.61 2.79-2.6-1.51-2.09zM14.67 10.1l1.51-2.09-2.79-2.6L3.67 0l11 10.1z"/>
    </svg>
  )}
  <span class="leading-tight text-left">
    <span class="block text-[10px] opacity-80">{copy.line1}</span>
    <span class="block text-sm font-semibold">{copy.line2}</span>
  </span>
</a>
