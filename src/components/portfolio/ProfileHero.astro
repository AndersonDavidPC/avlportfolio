---
export interface Props {
  name: string;
  role: string;
  headline?: string;
  location?: string;
  avatar: string;
  contact?: {
    email?: string;
    linkedin?: string;
    github?: string;
    website?: string;
  };
  highlights?: Array<{ value: string; label: string }>;
  compact?: boolean;
}

const { name, role, headline, location, avatar, contact, highlights = [], compact = false } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-primary-600 via-primary-700 to-primary-900 text-white">
  <!-- Decorative Elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-primary-200 rounded-full opacity-20 blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-accent-500/20 rounded-full opacity-20 blur-3xl"></div>
  </div>

  <div class="container-custom relative z-10">
    <div class={`${compact ? 'min-h-[50vh]' : 'min-h-[70vh]'} flex items-center`}>
      <div class="grid lg:grid-cols-2 gap-12 items-center w-full py-16">

        <!-- Content -->
        <div class="space-y-6 text-center lg:text-left order-2 lg:order-1">
          <div class="inline-block">
            <span class="px-4 py-2 rounded-full text-sm font-medium bg-white/20 text-white backdrop-blur-sm">
              {role}
            </span>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight text-white">
            {name}
          </h1>

          {headline && (
            <p class="text-xl leading-relaxed max-w-2xl mx-auto lg:mx-0 text-white/90">
              {headline}
            </p>
          )}

          {location && (
            <div class="flex items-center justify-center lg:justify-start space-x-2 text-white/80">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>{location}</span>
            </div>
          )}

          {contact && (
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-2">
              {contact.email && (
                <a href={`mailto:${contact.email}`} class="btn bg-white text-primary-700 hover:bg-neutral-100 px-6 py-3">
                  Contactar
                </a>
              )}
              <a href="#proyectos" class="btn btn-outline border-white text-white hover:bg-white hover:text-primary-700 px-6 py-3">
                Ver Proyectos
              </a>
            </div>
          )}

          {contact && (contact.linkedin || contact.github || contact.website) && (
            <div class="flex justify-center lg:justify-start space-x-4 pt-2">
              {contact.linkedin && (
                <a
                  href={contact.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-white/10 hover:bg-white/20 p-3 rounded-lg transition-colors duration-300 hover-lift"
                  aria-label={`LinkedIn de ${name}`}
                >
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
              )}

              {contact.github && (
                <a
                  href={contact.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-white/10 hover:bg-white/20 p-3 rounded-lg transition-colors duration-300 hover-lift"
                  aria-label={`GitHub de ${name}`}
                >
                  <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 013.01-.4c1.02 0 2.05.14 3.01.4 2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.92.43.37.81 1.1.81 2.22 0 1.61-.01 2.9-.01 3.29 0 .32.22.7.83.58C20.56 21.79 24 17.3 24 12c0-6.63-5.37-12-12-12z"/>
                  </svg>
                </a>
              )}

              {contact.website && (
                <a
                  href={contact.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-white/10 hover:bg-white/20 p-3 rounded-lg transition-colors duration-300 hover-lift"
                  aria-label={`Sitio web de ${name}`}
                >
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 010 18 15 15 0 010-18z"/>
                  </svg>
                </a>
              )}
            </div>
          )}
        </div>

        <!-- Avatar -->
        <div class="relative order-1 lg:order-2">
          <div class="relative z-10 max-w-xs mx-auto">
            <div class="rounded-full overflow-hidden ring-4 ring-white/40 shadow-2xl aspect-square">
              <img src={avatar} alt={name} class="w-full h-full object-cover" />
            </div>
          </div>

          {highlights.length > 0 && (
            <>
              <div class="absolute -top-2 -right-2 md:-right-8 bg-white rounded-lg shadow-lg p-4 max-w-[13rem] hidden md:block animation-delay-200 animate-fade-in">
                <div class="flex items-center space-x-3">
                  <div class="w-8 h-8 bg-gradient-to-r from-success to-[#3d8b40] rounded-full flex items-center justify-center flex-shrink-0">
                    <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div>
                    <p class="font-semibold text-neutral-800">{highlights[0].value}</p>
                    <p class="text-sm text-neutral-700">{highlights[0].label}</p>
                  </div>
                </div>
              </div>

              {highlights.length > 1 && (
                <div class="absolute -bottom-2 -left-2 md:-left-8 bg-white rounded-lg shadow-lg p-4 max-w-[13rem] hidden md:block animation-delay-400 animate-fade-in">
                  <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 bg-gradient-to-r from-primary-500 to-primary-700 rounded-full flex items-center justify-center flex-shrink-0">
                      <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3.005 3.005 0 013.75-2.906z" />
                      </svg>
                    </div>
                    <div>
                      <p class="font-semibold text-neutral-800">{highlights[1].value}</p>
                      <p class="text-sm text-neutral-700">{highlights[1].label}</p>
                    </div>
                  </div>
                </div>
              )}
            </>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
