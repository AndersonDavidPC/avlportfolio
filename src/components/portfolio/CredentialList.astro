---
export interface Props {
  title: string;
  education?: Array<{ institution: string; degree: string; location?: string; period: string; note?: string }>;
  certifications?: Array<{ name: string; issuer: string; year: string }>;
  languages?: Array<{ name: string; level: string }>;
}

const { title, education, certifications, languages } = Astro.props;
---

<div class="card p-6 lg:p-8 h-full">
  <h3 class="text-lg font-semibold text-neutral-800 mb-5">{title}</h3>

  {education && (
    <ul class="space-y-4">
      {education.map((item) => (
        <li>
          <p class="font-medium text-neutral-800">{item.degree}</p>
          <p class="text-sm text-neutral-600">
            {item.institution}{item.location && ` · ${item.location}`}
          </p>
          <p class="text-sm text-primary-800">{item.period}</p>
          {item.note && <p class="text-sm text-neutral-500 mt-1">{item.note}</p>}
        </li>
      ))}
    </ul>
  )}

  {certifications && (
    <ul class="space-y-3">
      {certifications.map((cert) => (
        <li>
          <p class="font-medium text-neutral-800 text-sm">{cert.name}</p>
          <p class="text-sm text-neutral-600">{cert.issuer} · {cert.year}</p>
        </li>
      ))}
    </ul>
  )}

  {languages && (
    <ul class="space-y-3">
      {languages.map((lang) => (
        <li class="flex items-center justify-between">
          <span class="font-medium text-neutral-800">{lang.name}</span>
          <span class="bg-primary-100 text-primary-700 px-3 py-1 rounded-full text-xs font-medium">{lang.level}</span>
        </li>
      ))}
    </ul>
  )}
</div>
