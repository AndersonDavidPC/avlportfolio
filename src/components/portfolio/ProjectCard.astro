---
import ProjectMedia from './ProjectMedia.astro';
import StoreBadge from './StoreBadge.astro';
import type { ProjectType } from '../../utils/projectMedia';

export interface Props {
  name: string;
  slug: string;
  type: ProjectType;
  visibility?: 'public' | 'private';
  org?: string;
  description: string;
  stack?: string[];
  metrics?: string[];
  links?: {
    appStore?: string;
    playStore?: string;
    web?: string;
    repo?: string;
  };
}

const {
  name,
  slug,
  type,
  visibility = 'public',
  org,
  description,
  stack = [],
  metrics = [],
  links,
} = Astro.props;

const typeLabel = type === 'mobile' ? 'App móvil · iOS y Android' : 'Aplicación web';
---

<div class="card p-6 lg:p-8 hover-lift group flex flex-col h-full">
  <ProjectMedia name={name} slug={slug} type={type} />

  <div class="flex flex-wrap gap-2 mb-4">
    {org && (
      <span class="bg-gradient-to-r from-primary-100 to-primary-200/50 text-primary-700 px-3 py-1 rounded-full text-sm font-medium">
        {org}
      </span>
    )}
    <span class="inline-flex items-center gap-1.5 bg-neutral-100 text-neutral-700 px-3 py-1 rounded-full text-sm font-medium">
      {type === 'mobile' ? (
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
        </svg>
      ) : (
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 010 18 15 15 0 010-18z"/>
        </svg>
      )}
      {typeLabel}
    </span>
  </div>

  <h3 class="text-xl font-semibold text-neutral-800 mb-3">{name}</h3>
  <p class="text-neutral-600 leading-relaxed mb-4">{description}</p>

  {metrics.length > 0 && (
    <ul class="space-y-2 mb-4">
      {metrics.map((metric) => (
        <li class="flex items-start space-x-2 text-sm text-primary-800 font-medium">
          <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          <span>{metric}</span>
        </li>
      ))}
    </ul>
  )}

  {stack.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-4">
      {stack.map((tech) => (
        <span class="bg-neutral-100 text-neutral-700 px-2.5 py-1 rounded-full text-xs font-medium">
          {tech}
        </span>
      ))}
    </div>
  )}

  <!-- Dónde consultarlo -->
  <div class="mt-auto pt-4 flex flex-wrap gap-3">
    {visibility === 'private' ? (
      <span class="inline-flex items-center gap-1.5 bg-neutral-100 text-neutral-600 rounded-full text-xs px-3 py-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 10-8 0v4h8z"/>
        </svg>
        Software privado{org && ` · ${org}`}
      </span>
    ) : type === 'mobile' ? (
      <>
        {links?.appStore && <StoreBadge store="appStore" href={links.appStore} appName={name} />}
        {links?.playStore && <StoreBadge store="playStore" href={links.playStore} appName={name} />}
      </>
    ) : (
      <>
        {links?.web && (
          <a
            href={links.web}
            target={links.web.startsWith('/') ? '_self' : '_blank'}
            rel={links.web.startsWith('/') ? undefined : 'noopener noreferrer'}
            class="btn btn-outline text-sm px-4 py-2 inline-flex items-center gap-1.5"
          >
            <span>Visitar sitio</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6v6M20 4L10 14"/>
            </svg>
          </a>
        )}
        {links?.repo && (
          <a
            href={links.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-primary-800 font-medium text-sm hover:text-primary-900 transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 013.01-.4c1.02 0 2.05.14 3.01.4 2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.92.43.37.81 1.1.81 2.22 0 1.61-.01 2.9-.01 3.29 0 .32.22.7.83.58C20.56 21.79 24 17.3 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>Código</span>
          </a>
        )}
      </>
    )}
  </div>
</div>
