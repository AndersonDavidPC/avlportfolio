---
export interface Props {
  category: string;
  items: string[];
}

const { category, items } = Astro.props;
---

<div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 lg:p-8 hover-lift">
  <h3 class="text-lg font-semibold text-white mb-4">{category}</h3>
  <div class="flex flex-wrap gap-2">
    {items.map((item) => (
      <span class="bg-white/10 text-white px-3 py-1.5 rounded-full text-sm">
        {item}
      </span>
    ))}
  </div>
</div>
